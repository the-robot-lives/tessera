{
  "name": "tessera-e2e",
  "private": true,
  "description": "Cypress e2e for the tessera demo apps (Hologram host + plain HTML)",
  "scripts": {
    "open": "cypress open",
    "run": "cypress run",
    "test": "cypress run",
    "test:fast": "cypress run --expose grepTags=@fast",
    "test:slow": "cypress run --expose grepTags=@slow"
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "axe-core": "^4.14.0",
    "cypress": "15.20.0",
    "typescript": "^5.5.0"
  }
}
